# OpenAI-Compatible AI Gateway / Custom LLM Provider
# Bebas pilih provider apa saja: OpenAI, 9Router, Ollama, Groq, OpenCode, LiteLLM, vLLM, dll.
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Default Active AI Provider ("custom_llm")
AI_PROVIDER=custom_llm

# AI Latency & Performance Settings (Configurable)
AI_CACHE_TTL_SECONDS=300
AI_MAX_TOKENS=2000
AI_TIMEOUT_SECONDS=45

# Telegram Notification Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Database Configuration
DATABASE_URL=sqlite:///./assiten_saham.db

# App Settings
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
