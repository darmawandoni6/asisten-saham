# 9Router Local AI Gateway (OpenAI-compatible)
NINEROUTER_API_KEY=your_9router_api_key_here
NINEROUTER_MODEL=9router
NINEROUTER_BASE_URL=http://localhost:20128/v1

# Default Active AI Provider ("9router")
AI_PROVIDER=9router

# AI Latency & Performance Settings (Configurable)
AI_CACHE_TTL_SECONDS=300
AI_MAX_TOKENS=2000
AI_TIMEOUT_SECONDS=45

# Telegram Notification Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Database Configuration
DATABASE_URL=sqlite:///./assiten_saham.db

# App Settings
PORT=8000
HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000
